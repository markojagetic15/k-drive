# Copy this file to .env and set your own admin password before deploying.
ADMIN_PASSWORD=changeme
PORT=4000

# ---------------------------------------------------------------------------
# Database — required. All content (texts, contact info, brand list...) lives
# in Postgres so it survives redeploys, even on hosts with an ephemeral
# filesystem (Render free tier, etc). Free options: neon.tech or supabase.com
# — create a project, copy its connection string here.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ---------------------------------------------------------------------------
# Cloudflare R2 — required for image uploads
# ---------------------------------------------------------------------------
# Your Cloudflare account ID (visible in the R2 dashboard URL or overview page)
R2_ACCOUNT_ID=your-cloudflare-account-id

# R2 API credentials — create these under:
#   Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Private S3-compatible API endpoint (replace <accountId> with your account ID)
R2_ENDPOINT=https://<accountId>.r2.cloudflarestorage.com

# The name you gave the bucket in the Cloudflare R2 dashboard (just the name, no URL)
R2_BUCKET_NAME=your-bucket-name

# Public base URL for reading uploaded images. Enable "Public Access" on your bucket:
#   Cloudflare Dashboard -> R2 -> <bucket> -> Settings -> Public Access
# Then use the r2.dev subdomain shown there, e.g.:
#   R2_PUBLIC_URL=https://pub-abc123.r2.dev
# Or a custom domain you have configured on the bucket.
R2_PUBLIC_URL=https://pub-REPLACE_ME.r2.dev

# ---------------------------------------------------------------------------
# SMTP — required for the contact form to send emails
# ---------------------------------------------------------------------------
# The inquiry form posts to /api/inquiry and emails contact.email from the
# CMS (Kontakt tab), sent "from" MAIL_FROM below using these credentials.
#
# Recommended for production: Resend (resend.com) — a transactional email
# service, not tied to anyone's personal inbox. Free tier: 3,000 emails/month.
#   1. Sign up at resend.com, verify your business domain (Domains -> Add
#      Domain -> add the DNS records they show you — takes a few minutes).
#   2. Create an API key (API Keys -> Create API Key).
#   3. Use it below exactly as shown — the SMTP username is literally the
#      word "resend", the API key is the password.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your-resend-api-key
# Must be on the domain you verified in Resend, e.g. upiti@your-domain.com.
# Required — there is no valid fallback, so this cannot be left unset.
MAIL_FROM=upiti@your-domain.com

# Alternative if you'd rather use a real mailbox instead of Resend: any Gmail
# account with an "App Password" (not the normal password) works too:
#   myaccount.google.com/security -> turn on 2-Step Verification
#   myaccount.google.com/apppasswords -> create one
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-gmail-address@gmail.com
# SMTP_PASS=your-16-character-app-password
# MAIL_FROM=your-gmail-address@gmail.com
