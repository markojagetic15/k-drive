# Copy this file to .env and set your own admin password before deploying.
ADMIN_PASSWORD=changeme
PORT=4000

# Optional - only needed in production when your host gives you a persistent
# volume at a specific path (Render/Railway/Fly.io disks, etc). Point these at
# that mounted path so the database and uploaded images survive redeploys.
# Leave unset for local development.
# DATA_DIR=/var/lib/k-drive/data
# UPLOADS_DIR=/var/lib/k-drive/uploads

# Required for the contact form to actually send emails. Free option: use a
# Gmail account with an "App Password" (not your normal password):
#   1. myaccount.google.com/security -> turn on 2-Step Verification
#   2. myaccount.google.com/apppasswords -> create one, use it below
# The inquiry form posts to /api/inquiry and emails contact.email from the
# CMS (Kontakt tab) using these credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-app-password
# MAIL_FROM=your-gmail-address@gmail.com
